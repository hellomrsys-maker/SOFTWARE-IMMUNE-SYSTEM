# Environment Variables — Software Immune System
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://sis:sis_password@localhost:5432/sis_dev

# ── IBM Bob Integration ──────────────────────────────────────────────────────
# Set to "true" to enable live Bob API calls.
# When "false" all Bob tasks return explicit stub notices — never silent degradation.
BOB_INTEGRATION_ENABLED=false
BOB_API_ENDPOINT=https://your-bob-endpoint.example.com
# IMPORTANT: this key is a placeholder — do not commit real credentials
BOB_API_KEY=test-key-not-real

# ── Sandbox ──────────────────────────────────────────────────────────────────
# "docker" or "podman" — selects the container runtime for isolated execution
SANDBOX_RUNTIME=docker

# ── Artifact Storage ─────────────────────────────────────────────────────────
ARTIFACT_STORAGE_PATH=/var/sis/artifacts

# ── Control API ──────────────────────────────────────────────────────────────
CONTROL_API_PORT=3000
# IMPORTANT: replace with a cryptographically random secret before any deployment
JWT_SECRET=change-me-in-production

# ── Worker ───────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=4

# ── Runtime Environment ───────────────────────────────────────────────────────
# Must be "test" to enable fault injection; never set to "production" in dev
NODE_ENV=development

# ── Payment Simulator (test credentials only) ─────────────────────────────────
# IMPORTANT: these are fake test credentials — no real payment processing occurs
PAYMENT_API_KEY=test-key-not-real
